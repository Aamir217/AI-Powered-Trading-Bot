# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret that must appear in every TradingView alert payload.
# Put the same value in your TradingView alert message JSON (see README)
# so requests without it are rejected.
TRADINGVIEW_WEBHOOK_SECRET=change-me

# Model used to analyze incoming signals
CLAUDE_MODEL=claude-sonnet-5

# When true, no orders are sent to a broker - alerts are analyzed and logged only.
DRY_RUN=true

# --- BLACK-GOLD strategy / MetaApi (required only once DRY_RUN=false) ---
# MetaApi.cloud token and the MT4/MT5 account id you registered there.
# https://metaapi.cloud/ - connects to your existing broker account (use a
# DEMO account while testing).
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

LOT_SIZE=0.01
TAKE_PROFIT_USD=10
DAILY_PROFIT_TARGET_USD=10
TP_POLL_SECONDS=5

