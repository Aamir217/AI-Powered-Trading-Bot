# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret that must appear in every TradingView alert payload.
# Put the same value in your TradingView alert message JSON (see README)
# so requests without it are rejected.
TRADINGVIEW_WEBHOOK_SECRET=change-me

# Model used to analyze incoming signals
CLAUDE_MODEL=claude-sonnet-5

# When true, no orders are sent to a broker - alerts are analyzed and logged only.
DRY_RUN=true
